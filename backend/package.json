{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpileOnly src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "restart": "kill-port 4000 && npm run build && npm start",
    "prisma": "prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "mariadb": "^3.4.5",
    "mysql2": "^3.15.3",
    "mysqli": "^3.1.4"
  },
  "skipLibCheck": true,
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/mysql": "^2.15.27",
    "@types/node": "^20.0.0",
    "kill-port": "^2.0.1",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
